// Cloudflare Workers settings for maartenstapel.dk.
// The website files live in ./public and are served as static files.
{
  "name": "maartenstapel-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Show public/404.html (with a 404 status) for pages that don't exist
    "not_found_handling": "404-page"
  },
  // Needed for the automatic test build of each pull request ("npx wrangler preview").
  // Empty on purpose: previews reuse the settings above.
  "previews": {}
}
